<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head") %>
</head>
<body>

<%- include("partials/nav") %>

<main>
  <h1>Writing</h1>
  <p>Notes on systems, C, and how computers actually work underneath.</p>

  <% if (!posts || posts.length === 0) { %>
    <p>Nothing published yet.</p>
  <% } else { %>
  <ul class="posts">
    <% posts.forEach(function (post) {
      const d = new Date(post.publishedAt || post.updatedAt);
      const iso = d.toISOString().slice(0, 10);
      const shown = d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    %>
    <li>
      <time datetime="<%= iso %>"><%= shown %></time>
      <a href="/blogs/<%= post.slug %>"><%= post.title %></a>
    </li>
    <% }); %>
  </ul>
  <% } %>
</main>

</body>
</html>
