<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>">
<head>
  <%- include("partials/head") %>
</head>
<body>

<%- include("partials/nav") %>

<main>
  <h1>Blogs</h1>
  <p>Pieces on systems programming , C/C++ , OS , go and my life.</p>

  <% if (!posts || posts.length === 0) { %>
    <p>Nothing published yet.</p>
  <% } else { %>
  <ul class="posts">
    <% posts.forEach(function (post) {
      const d = new Date(post.publishedAt || post.updatedAt);
      const iso = d.toISOString().slice(0, 10);
      const shown = d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    %>
    <li>
      <time datetime="<%= iso %>"><%= shown %></time>
      <a href="/blogs/<%= post.slug %>"><%= post.title %></a>
    </li>
    <% }); %>
  </ul>
  <% } %>
</main>

<% if (posts && posts.length) { %>
<script src="/prefetch.js" defer></script>
<% } %>

</body>
</html>
