<!DOCTYPE html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>">
<head>
  <%- include("partials/head") %>
</head>
<body>

<%- include("partials/nav") %>

<%
  const pubDate = new Date(post.publishedAt || post.updatedAt);
  const pubFull = pubDate.toLocaleString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  const pubIso = pubDate.toISOString().slice(0, 10);
%>

<article>
  <h1><%= post.title %></h1>
  <p class="byline">
    <time datetime="<%= pubIso %>"><%= pubFull %></time><% if (post.tags && post.tags.length) { %>
    &middot; <%= post.tags.join(', ') %><% } %>
  </p>

  <div class="post-body">
    <%- post.html %>
  </div>
</article>

<% if (prevPost || nextPost) { %>
<hr />
<nav class="pager" aria-label="More articles">
  <% if (prevPost) { %><a href="/blogs/<%= prevPost.slug %>">&larr; <%= prevPost.title %></a><% } else { %><span></span><% } %>
  <% if (nextPost) { %><a href="/blogs/<%= nextPost.slug %>"><%= nextPost.title %> &rarr;</a><% } %>
</nav>
<% } %>

<% if (prevPost || nextPost) { %>
<script src="/prefetch.js" defer></script>
<% } %>

</body>
</html>
