<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head-admin") %>
  </head>
  <body class="writer-mode">
    <main>
      <header class="admin-header">
        <h1>Media Library</h1>
        <nav>
          <a href="/admin/posts">Posts</a>
          <a href="/">Index</a>
          <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
            <svg class="icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg class="icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          <form method="post" action="/admin/logout">
            <button class="button" type="submit">Logout</button>
          </form>
        </nav>
      </header>

      <div class="media-shell">
        <div id="error-banner" class="flash error" style="display:none;margin-bottom:1rem;"></div>

        <div class="media-toolbar">
          <label class="upload-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
            Upload image
            <input id="file-input" type="file" accept="image/*" hidden />
          </label>
          <span id="upload-status"></span>
        </div>

        <% if (images.length === 0) { %>
          <p class="empty-msg">No images in S3 yet. Upload one above.</p>
        <% } else { %>
        <table class="media-table" id="media-table">
          <thead>
            <tr>
              <th></th>
              <th>Key</th>
              <th>URL</th>
              <th>Size</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% images.forEach(function(img, i) { %>
            <tr data-key="<%= img.key %>" data-url="<%= img.url %>" data-index="<%= i %>">
              <td>
                <button type="button" class="thumb-button" data-view aria-label="View <%= img.key %>">
                  <img class="thumb" src="<%= img.url %>" alt="" loading="lazy" />
                </button>
              </td>
              <td class="key-cell" title="<%= img.key %>"><%= img.key %></td>
              <td>
                <div class="url-cell">
                  <span class="url-text" title="<%= img.url %>"><%= img.url %></span>
                  <button class="copy-btn" data-url="<%= img.url %>">Copy</button>
                </div>
              </td>
              <td class="size-cell"><%= (img.size / 1024).toFixed(0) %> KB</td>
              <td>
                <button class="del-btn" data-key="<%= img.key %>">Delete</button>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
      </div>
    </main>

    <%# Lightbox — full-size viewing with zoom, pan and stepping between images. %>
    <div class="lightbox" data-lightbox hidden>
      <div class="lightbox-stage" data-stage>
        <button type="button" class="lightbox-close" data-close aria-label="Close">&times;</button>
        <button type="button" class="lightbox-nav lightbox-prev" data-prev aria-label="Previous image">&lsaquo;</button>
        <img class="lightbox-img" data-lightbox-img src="" alt="" />
        <button type="button" class="lightbox-nav lightbox-next" data-next aria-label="Next image">&rsaquo;</button>
      </div>
      <div class="lightbox-bar">
        <span class="lightbox-key" data-lightbox-key></span>
        <div class="lightbox-zoom">
          <button type="button" data-zoom-out aria-label="Zoom out">&minus;</button>
          <span class="lightbox-zoom-level" data-zoom-level>100%</span>
          <button type="button" data-zoom-in aria-label="Zoom in">+</button>
          <button type="button" data-zoom-fit>Fit</button>
        </div>
        <div class="lightbox-actions">
          <button type="button" data-copy-url>Copy URL</button>
          <button type="button" data-copy-md>Copy markdown</button>
          <button type="button" class="del-btn" data-delete>Delete</button>
        </div>
      </div>
    </div>

    <script type="module" src="/media.js"></script>
  </body>
</html>
